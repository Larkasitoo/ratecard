{"info":{"description":"Instant, benchmark-based brand-deal price estimates for creators. No authentication required.","title":"RateCard API","version":"1.0.0"},"openapi":"3.0.3","paths":{"/api/content-types":{"get":{"responses":{"200":{"description":"Content-type list"}},"summary":"List supported content types and their rate multipliers"}},"/api/health":{"get":{"responses":{"200":{"description":"Service status"}},"summary":"Health check"}},"/api/niches":{"get":{"responses":{"200":{"description":"Niche list"}},"summary":"List supported creator niches and their base rates"}},"/api/platforms":{"get":{"responses":{"200":{"description":"Platform list"}},"summary":"List supported platforms and their rate multipliers"}},"/api/price":{"post":{"requestBody":{"content":{"application/json":{"schema":{"properties":{"content_type":{"default":"post","description":"Content-type id (see GET /api/content-types)","example":"short_video","type":"string"},"engagement_rate":{"description":"Optional engagement rate as a percent, e.g. 4.2 = 4.2%","example":4.2,"type":"number"},"followers":{"description":"Follower/subscriber count, 1000 to 100000000","example":50000,"type":"number"},"niche":{"description":"Creator niche id (see GET /api/niches)","example":"fitness","type":"string"},"platform":{"default":"instagram","description":"Platform id (see GET /api/platforms)","example":"instagram","type":"string"}},"required":["niche","followers"],"type":"object"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"properties":{"add_ons":{"type":"object"},"currency":{"example":"USD","type":"string"},"disclaimer":{"type":"string"},"estimate":{"properties":{"high":{"type":"number"},"low":{"type":"number"},"mid":{"type":"number"}},"type":"object"},"tier":{"example":"micro","type":"string"},"tips":{"items":{"type":"string"},"type":"array"}},"type":"object"}}},"description":"Price estimate with low/mid/high range, add-ons, and tips"},"400":{"description":"Invalid input"}},"summary":"Estimate a brand-deal price range"}}},"servers":[{"description":"Production","url":"https://ratecard.example.com"}]}